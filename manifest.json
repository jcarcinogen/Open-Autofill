{
  "manifest_version": 3,
  "name": "Open Autofill",
  "short_name": "Open Autofill",
  "version": "1.5.2",
  "description": "Free local form memory. Fills the fields you use again. No cloud. No daily limit.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Autofill",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/shared.js", "src/matcher.js", "src/content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "fill-page": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Fill this page from memory"
    },
    "remember-page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Remember fields on this page"
    }
  }
}
